{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhanghao1903/macos-computer-use/blob/main/plugins/codex-claude-engineering-lifecycle/schemas/claude-bootstrap-output.schema.json",
  "title": "ClaudeBootstrapOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "messageId",
    "requestDigest",
    "workflowId",
    "repositoryKey",
    "sessionId",
    "role",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "ClaudeRoleReady"
    },
    "messageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowId": {
      "type": "string",
      "format": "uuid"
    },
    "repositoryKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "enum": [
        "frontend",
        "review"
      ]
    },
    "status": {
      "const": "READY"
    }
  }
}
