{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhanghao1903/macos-computer-use/blob/main/plugins/codex-claude-engineering-lifecycle/schemas/frontend-work-request.schema.json",
  "title": "FrontendWorkRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "messageId",
    "workflowId",
    "repositoryKey",
    "featureId",
    "cycle",
    "branch",
    "startHeadSha",
    "planCommitSha",
    "planCompositeSha256",
    "objective",
    "allowedPathPrefixes",
    "acceptanceCriteria",
    "verificationCommands",
    "previousResultMessageId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "FrontendWorkRequest"
    },
    "messageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowId": {
      "type": "string",
      "format": "uuid"
    },
    "repositoryKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?-[0-9a-f]{12}$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "startHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "planCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "planCompositeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "allowedPathPrefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!-)(?!.*\\\\).+$"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "verificationCommands": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "previousResultMessageId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    }
  }
}
