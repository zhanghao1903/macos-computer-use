{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhanghao1903/macos-computer-use/blob/main/plugins/codex-claude-engineering-lifecycle/schemas/claude-frontend-output.schema.json",
  "title": "ClaudeFrontendOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "messageId",
    "requestDigest",
    "workflowId",
    "repositoryKey",
    "featureId",
    "cycle",
    "sessionId",
    "status",
    "startHeadSha",
    "endHeadSha",
    "commitShas",
    "modifiedPaths",
    "verification",
    "summary",
    "questions",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "ClaudeFrontendOutput"
    },
    "messageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowId": {
      "type": "string",
      "format": "uuid"
    },
    "repositoryKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?-[0-9a-f]{12}$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "BLOCKED",
        "FAILED"
      ]
    },
    "startHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "endHeadSha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "commitShas": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "modifiedPaths": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!-)(?!.*\\\\).+$"
      }
    },
    "verification": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "questions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      ]
    }
  }
}
