{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-control.local/schemas/app_control.helper.request.v1.schema.json",
  "title": "App Control Helper Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command"],
  "properties": {
    "schema": { "const": "app_control.helper.request.v1" },
    "token": { "type": "string", "minLength": 1 },
    "command": { "$ref": "#/$defs/command" },
    "metadata": { "$ref": "#/$defs/jsonObject" }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "command": {
      "type": "object",
      "required": ["commandId", "tool", "operation"],
      "additionalProperties": true,
      "properties": {
        "schema": { "const": "app_control.command.v1" },
        "commandId": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
