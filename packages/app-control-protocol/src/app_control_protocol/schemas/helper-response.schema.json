{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-control.local/schemas/app_control.helper.response.v1.schema.json",
  "title": "App Control Helper Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "success"],
  "properties": {
    "schema": { "const": "app_control.helper.response.v1" },
    "success": { "type": "boolean" },
    "observation": { "$ref": "#/$defs/jsonObject" },
    "error": { "$ref": "#/$defs/error" },
    "metadata": { "$ref": "#/$defs/jsonObject" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "success": { "const": true } },
        "required": ["success"]
      },
      "then": { "required": ["observation"] }
    },
    {
      "if": {
        "properties": { "success": { "const": false } },
        "required": ["success"]
      },
      "then": {
        "oneOf": [
          { "required": ["observation"] },
          { "required": ["error"] }
        ]
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureKind", "message", "retryable"],
      "properties": {
        "failureKind": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "recoveryHint": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "phase": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/jsonObject" }
      }
    }
  }
}
