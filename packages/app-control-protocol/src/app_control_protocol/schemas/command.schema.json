{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-control.local/schemas/app_control.command.v1.schema.json",
  "title": "App Control ToolCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "commandId", "tool", "operation", "input"],
  "properties": {
    "schema": { "const": "app_control.command.v1" },
    "commandId": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "input": { "$ref": "#/$defs/jsonObject" },
    "timeoutMs": { "type": "integer", "minimum": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "metadata": { "$ref": "#/$defs/jsonObject" }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  }
}
