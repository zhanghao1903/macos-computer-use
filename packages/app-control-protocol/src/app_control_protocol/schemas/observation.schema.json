{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-control.local/schemas/app_control.observation.v1.schema.json",
  "title": "App Control ToolObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "commandId",
    "tool",
    "operation",
    "status",
    "success",
    "summary",
    "observation"
  ],
  "properties": {
    "schema": { "const": "app_control.observation.v1" },
    "commandId": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "not_found",
        "not_ready",
        "permission_missing",
        "timeout",
        "failed",
        "unknown"
      ]
    },
    "success": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1 },
    "observation": { "$ref": "#/$defs/jsonObject" },
    "evidence": { "$ref": "#/$defs/jsonObject" },
    "timing": { "$ref": "#/$defs/jsonObject" },
    "failureKind": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "recoveryHint": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "error": { "$ref": "#/$defs/error" },
    "metadata": { "$ref": "#/$defs/jsonObject" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ok" } },
        "required": ["status"]
      },
      "then": { "properties": { "success": { "const": true } } },
      "else": { "properties": { "success": { "const": false } } }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureKind", "message", "retryable"],
      "properties": {
        "failureKind": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "recoveryHint": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "phase": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/jsonObject" }
      }
    }
  }
}
