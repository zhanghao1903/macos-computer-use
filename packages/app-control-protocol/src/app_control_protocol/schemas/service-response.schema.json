{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-control.local/schemas/app_control.service.response.v1.schema.json",
  "title": "App Control Local Service Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "success"],
  "properties": {
    "schema": { "const": "app_control.service.response.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["complete", "not_found", "failed"] },
    "success": { "type": "boolean" },
    "observation": { "$ref": "#/$defs/jsonObject" },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": { "properties": { "success": { "const": true } } },
      "else": { "properties": { "success": { "const": false } } }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": { "required": ["error"] }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureKind", "message", "retryable"],
      "properties": {
        "failureKind": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "recoveryHint": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "phase": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/jsonObject" }
      }
    }
  }
}
